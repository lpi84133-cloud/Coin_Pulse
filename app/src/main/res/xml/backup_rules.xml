<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device and nothing is restored onto a new one. The lane
    an install settled on, the page it was given and the encrypted store's keys
    are all specific to this device and this install; carrying them across would
    hand a fresh install someone else's decision.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
