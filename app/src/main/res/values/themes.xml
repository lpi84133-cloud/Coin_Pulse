<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CoinPulse" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!--
        The full-bleed boards: splash, no-signal, notifications. Black behind the
        artwork and no window animation, so nothing of the system shows between
        one board and the next.
    -->
    <style name="Theme.CoinPulse.Board" parent="Theme.CoinPulse">
        <!--
            The window-preview colour matches BootCurtain.BACKDROP so the system
            can show the preview colour immediately on cold starts — particularly
            notification taps — without a visible black flash before the custom
            view draws its first frame.
        -->
        <item name="android:windowBackground">@color/boot_backdrop</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
        The page host. The preview window is switched off here on purpose: the
        WebView takes a moment to warm up, and the system's stand-in for that
        moment is the white-then-black flash with an Android robot in it that
        users report as the app crashing on open.
    -->
    <style name="Theme.CoinPulse.Page" parent="Theme.CoinPulse.Board">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
